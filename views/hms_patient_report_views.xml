<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_patient">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="patient">
                    <div class="page">
                        <style>
                            .report-page {
                                background: #f5f5f5;
                                border: 2px solid #3498db;
                                padding: 20px;
                                margin: 15px;
                                font-family: Arial, sans-serif;
                            }
                            .report-header {
                                display: flex;
                                justify-content: space-between;
                                align-items: center;
                                margin-bottom: 20px;
                                border-bottom: 2px solid #3498db;
                                padding-bottom: 10px;
                            }
                            .report-title {
                                color: #e74c3c;
                                font-size: 24px;
                                font-weight: bold;
                                margin: 0;
                            }
                            .patient-image {
                                width: 80px;
                                height: 80px;
                                object-fit: cover;
                                border: 1px solid #ccc;
                            }
                            .patient-info {
                                display: flex;
                                gap: 40px;
                                margin-bottom: 20px;
                            }
                            .info-column {
                                flex: 1;
                            }
                            .info-label {
                                font-weight: bold;
                                color: #000;
                                display: inline-block;
                                min-width: 100px;
                            }
                            .info-value {
                                color: #000;
                            }
                            .info-row {
                                margin-bottom: 6px;
                            }
                            .log-section {
                                margin-top: 10px;
                            }
                            .log-title {
                                color: #e74c3c;
                                font-size: 18px;
                                font-weight: bold;
                                text-align: center;
                                margin-bottom: 10px;
                            }
                            .log-table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .log-table th {
                                background: #3498db;
                                color: #fff;
                                padding: 8px 10px;
                                text-align: left;
                                border: 1px solid #fff;
                            }
                            .log-table td {
                                padding: 6px 10px;
                                border: 1px solid #fff;
                            }
                            .log-table tr:nth-child(even) td {
                                background: #f0f0f0;
                            }
                            .log-table tr:nth-child(odd) td {
                                background: #fff;
                            }
                        </style>

                        <div class="report-page">
                            <div class="report-header">
                                <h1 class="report-title">Patient Status Report</h1>
                                <t t-if="patient.image">
                                    <img class="patient-image" t-attf-src="data:image/png;base64,#{patient.image.decode()}" alt="Patient Image"/>
                                </t>
                                <t t-else="">
                                    <div class="patient-image" style="background: #ddd;"/>
                                </t>
                            </div>

                            <div class="patient-info">
                                <div class="info-column">
                                    <div class="info-row">
                                        <span class="info-label">Name:</span>
                                        <span class="info-value" t-out="patient.name"/>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Age:</span>
                                        <span class="info-value" t-out="patient.age"/>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Department:</span>
                                        <span class="info-value" t-out="patient.department_id.name"/>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Doctors:</span>
                                        <span class="info-value" t-out="', '.join(patient.doctor_ids.mapped('name'))"/>
                                    </div>
                                </div>

                                <div class="info-column">
                                    <div class="info-row">
                                        <span class="info-label">Birth Date:</span>
                                        <span class="info-value" t-out="patient.birthdate"/>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">PCR:</span>
                                        <span class="info-value">
                                            <t t-if="patient.pcr">Yes</t>
                                            <t t-else="">No</t>
                                        </span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Blood Type:</span>
                                        <span class="info-value" t-out="patient.blood_type"/>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">Email:</span>
                                        <span class="info-value" t-out="patient.email"/>
                                    </div>
                                </div>
                            </div>

                            <div class="log-section">
                                <h2 class="log-title">Log History</h2>
                                <table class="log-table">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Date</th>
                                            <th>Info</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="patient.log_ids" t-as="log">
                                            <tr>
                                                <td t-out="log.created_by.name"/>
                                                <td t-out="log.date"/>
                                                <td t-out="log.description"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record id="action_report_patient" model="ir.actions.report">
            <field name="name">Patient Report</field>
            <field name="model">hms.patient</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hms.report_patient</field>
            <field name="report_file">hms.report_patient</field>
            <field name="print_report_name">'Patient Report - %s' % object.name</field>
            <field name="binding_model_id" ref="model_hms_patient"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
