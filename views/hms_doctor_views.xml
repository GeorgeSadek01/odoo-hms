<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hms_doctor_view_tree" model="ir.ui.view">
            <field name="name">hms.doctor.tree</field>
            <field name="model">hms.doctor</field>
            <field name="arch" type="xml">
                <list string="Doctors">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="department_id"/>
                </list>
            </field>
        </record>

        <record id="hms_doctor_view_form" model="ir.ui.view">
            <field name="name">hms.doctor.form</field>
            <field name="model">hms.doctor</field>
            <field name="arch" type="xml">
                <form string="Doctor">
                    <sheet>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="image" widget="image"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hms_doctor_action" model="ir.actions.act_window">
            <field name="name">Doctors</field>
            <field name="res_model">hms.doctor</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hms_menu_doctors" name="Doctors" parent="hms_menu_root" action="hms_doctor_action" sequence="30"/>
    </data>
</odoo>
