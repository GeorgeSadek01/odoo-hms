<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hms_department_view_tree" model="ir.ui.view">
            <field name="name">hms.department.tree</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <list string="Departments">
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="is_opened"/>
                </list>
            </field>
        </record>

        <record id="hms_department_view_form" model="ir.ui.view">
            <field name="name">hms.department.form</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                            <field name="is_opened"/>
                        </group>
                        <notebook>
                            <page string="Doctors">
                                <field name="doctor_ids">
                                    <list>
                                        <field name="first_name"/>
                                        <field name="last_name"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Patients">
                                <field name="patient_ids">
                                    <list>
                                        <field name="first_name"/>
                                        <field name="last_name"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hms_department_action" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">hms.department</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hms_menu_departments" name="Departments" parent="hms_menu_root" action="hms_department_action" sequence="20"/>
    </data>
</odoo>
