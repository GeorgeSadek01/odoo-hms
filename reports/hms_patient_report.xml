<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hms_patient_report" model="ir.actions.report">
            <field name="name">Patient Status Report</field>
            <field name="model">hms.patient</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hms.report_patient_status</field>
            <field name="report_file">hms.report_patient_status</field>
        </record>

        <template id="report_patient_status">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page" style="background-color: #f5f5f5; padding: 20px; min-height: 100%;">
                        <div style="border: 2px solid #3498db; border-radius: 8px; padding: 25px; background-color: #ffffff; min-height: 95%;">

                            <!-- Header Section -->
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; border-bottom: 1px solid #ddd; padding-bottom: 15px;">
                                <div>
                                    <h1 style="color: #e74c3c; font-size: 28px; font-weight: bold; margin: 0;">Patient Status Report</h1>
                                </div>
                                <div>
                                    <t t-if="doc.image">
                                        <img t-att-src="'data:image/png;base64,' + doc.image.decode('utf-8')" style="width: 100px; height: 100px; object-fit: cover; border-radius: 6px; border: 1px solid #ccc;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width: 100px; height: 100px; background-color: #f0f0f0; border-radius: 6px; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center; color: #999; font-size: 12px;">No Image</div>
                                    </t>
                                </div>
                            </div>

                            <!-- Patient Information Section -->
                            <div style="display: flex; gap: 40px; margin-bottom: 25px;">
                                <!-- Left Column -->
                                <div style="flex: 1;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333; width: 35%;">Name</td>
                                            <td style="color: #333;"><t t-out="doc.name"/></td>
                                        </tr>
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333;">Age</td>
                                            <td style="color: #333;"><t t-out="doc.age"/></td>
                                        </tr>
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333;">Department</td>
                                            <td style="color: #333;"><t t-if="doc.department_id" t-out="doc.department_id.name"/><t t-else="">—</t></td>
                                        </tr>
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333;">Doctors</td>
                                            <td style="color: #333;"><t t-if="doc.doctor_ids" t-out="', '.join(doc.doctor_ids.mapped('name'))"/><t t-else="">—</t></td>
                                        </tr>
                                    </table>
                                </div>
                                <!-- Right Column -->
                                <div style="flex: 1;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333; width: 35%;">Birth Date</td>
                                            <td style="color: #333;"><t t-out="doc.birthdate" t-options='{"widget": "date"}'/></td>
                                        </tr>
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333;">PCR</td>
                                            <td style="color: #333;"><t t-if="doc.pcr">Yes</t><t t-else="">No</t></td>
                                        </tr>
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333;">Blood Type</td>
                                            <td style="color: #333;"><t t-if="doc.blood_type" t-out="doc.blood_type"/><t t-else="">—</t></td>
                                        </tr>
                                        <tr style="height: 35px;">
                                            <td style="font-weight: bold; color: #333;">Email</td>
                                            <td style="color: #333;"><t t-if="doc.email" t-out="doc.email"/><t t-else="">—</t></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Log History Section -->
                            <div style="margin-top: 10px;">
                                <h3 style="text-align: center; color: #e74c3c; font-weight: bold; margin-bottom: 15px;">Log History</h3>
                                <table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
                                    <thead>
                                        <tr style="background-color: #3498db; color: #ffffff;">
                                            <th style="padding: 10px; text-align: left; border: 1px solid #ffffff;">User</th>
                                            <th style="padding: 10px; text-align: left; border: 1px solid #ffffff;">Date</th>
                                            <th style="padding: 10px; text-align: left; border: 1px solid #ffffff;">Info</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="row_index" t-value="0"/>
                                        <t t-foreach="doc.log_ids" t-as="log">
                                            <t t-set="row_index" t-value="row_index + 1"/>
                                            <tr t-att-style="'background-color: #f9f9f9;' if row_index % 2 == 0 else 'background-color: #ffffff;'">
                                                <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="log.created_by.name"/></td>
                                                <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="log.date" t-options='{"widget": "date"}'/></td>
                                                <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="log.description"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="not doc.log_ids">
                                            <tr>
                                                <td colspan="3" style="padding: 15px; text-align: center; color: #999; border: 1px solid #ddd;">No log entries</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>