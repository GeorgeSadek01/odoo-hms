<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Departments -->
        <record id="hms_department_cardiology" model="hms.department">
            <field name="name">Cardiology</field>
            <field name="capacity">50</field>
            <field name="is_opened" eval="True"/>
        </record>

        <record id="hms_department_neurology" model="hms.department">
            <field name="name">Neurology</field>
            <field name="capacity">30</field>
            <field name="is_opened" eval="True"/>
        </record>

        <record id="hms_department_pediatrics" model="hms.department">
            <field name="name">Pediatrics</field>
            <field name="capacity">40</field>
            <field name="is_opened" eval="True"/>
        </record>

        <record id="hms_department_radiology" model="hms.department">
            <field name="name">Radiology</field>
            <field name="capacity">20</field>
            <field name="is_opened" eval="False"/>
        </record>

        <!-- Doctors -->
        <record id="hms_doctor_ahmed" model="hms.doctor">
            <field name="first_name">Ahmed</field>
            <field name="last_name">Hassan</field>
            <field name="department_id" ref="hms_department_cardiology"/>
        </record>

        <record id="hms_doctor_sara" model="hms.doctor">
            <field name="first_name">Sara</field>
            <field name="last_name">Mohamed</field>
            <field name="department_id" ref="hms_department_neurology"/>
        </record>

        <record id="hms_doctor_omar" model="hms.doctor">
            <field name="first_name">Omar</field>
            <field name="last_name">Ali</field>
            <field name="department_id" ref="hms_department_pediatrics"/>
        </record>

        <!-- Patients -->
        <record id="hms_patient_john" model="hms.patient">
            <field name="first_name">John</field>
            <field name="last_name">Doe</field>
            <field name="email">john.doe@example.com</field>
            <field name="birthdate">1991-05-15</field>
            <field name="blood_type">A+</field>
            <field name="pcr" eval="False"/>
            <field name="cr_ratio">1.2</field>
            <field name="address">123 Main Street, Cairo</field>
            <field name="department_id" ref="hms_department_cardiology"/>
            <field name="doctor_ids" eval="[(6, 0, [ref('hms_doctor_ahmed')])]"/>
            <field name="state">good</field>
        </record>

        <record id="hms_patient_jane" model="hms.patient">
            <field name="first_name">Jane</field>
            <field name="last_name">Smith</field>
            <field name="email">jane.smith@example.com</field>
            <field name="birthdate">1998-08-22</field>
            <field name="blood_type">B-</field>
            <field name="pcr" eval="True"/>
            <field name="cr_ratio">0.8</field>
            <field name="address">456 Oak Avenue, Giza</field>
            <field name="department_id" ref="hms_department_neurology"/>
            <field name="doctor_ids" eval="[(6, 0, [ref('hms_doctor_sara')])]"/>
            <field name="state">fair</field>
        </record>

        <record id="hms_patient_bob" model="hms.patient">
            <field name="first_name">Bob</field>
            <field name="last_name">Johnson</field>
            <field name="email">bob.johnson@example.com</field>
            <field name="birthdate">1971-02-10</field>
            <field name="blood_type">O+</field>
            <field name="pcr" eval="False"/>
            <field name="cr_ratio">1.5</field>
            <field name="address">789 Pine Road, Alexandria</field>
            <field name="department_id" ref="hms_department_cardiology"/>
            <field name="doctor_ids" eval="[(6, 0, [ref('hms_doctor_ahmed')])]"/>
            <field name="state">serious</field>
        </record>

        <record id="hms_patient_alice" model="hms.patient">
            <field name="first_name">Alice</field>
            <field name="last_name">Williams</field>
            <field name="email">alice.williams@example.com</field>
            <field name="birthdate">1961-11-30</field>
            <field name="blood_type">AB+</field>
            <field name="pcr" eval="True"/>
            <field name="cr_ratio">2.1</field>
            <field name="address">321 Elm Street, Luxor</field>
            <field name="department_id" ref="hms_department_pediatrics"/>
            <field name="doctor_ids" eval="[(6, 0, [ref('hms_doctor_omar')])]"/>
            <field name="state">undetermined</field>
        </record>

        <!-- Patient Logs -->
        <record id="hms_log_john_1" model="hms.patient.log">
            <field name="patient_id" ref="hms_patient_john"/>
            <field name="created_by" ref="base.user_admin"/>
            <field name="date">2024-01-15 09:00:00</field>
            <field name="description">Patient admitted to Cardiology</field>
        </record>

        <record id="hms_log_john_2" model="hms.patient.log">
            <field name="patient_id" ref="hms_patient_john"/>
            <field name="created_by" ref="base.user_admin"/>
            <field name="date">2024-01-20 14:30:00</field>
            <field name="description">State changed to Good</field>
        </record>

        <record id="hms_log_jane_1" model="hms.patient.log">
            <field name="patient_id" ref="hms_patient_jane"/>
            <field name="created_by" ref="base.user_admin"/>
            <field name="date">2024-02-10 11:15:00</field>
            <field name="description">Patient admitted to Neurology</field>
        </record>

        <record id="hms_log_bob_1" model="hms.patient.log">
            <field name="patient_id" ref="hms_patient_bob"/>
            <field name="created_by" ref="base.user_admin"/>
            <field name="date">2024-03-05 08:45:00</field>
            <field name="description">Patient admitted to Cardiology</field>
        </record>

        <record id="hms_log_bob_2" model="hms.patient.log">
            <field name="patient_id" ref="hms_patient_bob"/>
            <field name="created_by" ref="base.user_admin"/>
            <field name="date">2024-03-10 16:00:00</field>
            <field name="description">State changed to Serious</field>
        </record>

        <record id="hms_log_alice_1" model="hms.patient.log">
            <field name="patient_id" ref="hms_patient_alice"/>
            <field name="created_by" ref="base.user_admin"/>
            <field name="date">2024-04-20 13:20:00</field>
            <field name="description">Patient admitted to Pediatrics</field>
        </record>
    </data>
</odoo>
